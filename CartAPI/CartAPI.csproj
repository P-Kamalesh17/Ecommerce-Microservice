<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b2f6c1a4-8d3e-4f57-9a10-6c2e7d5b9e31</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommerce.Shared\ECommerce.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
	  <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
