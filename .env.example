# Copy to .env and fill in. Azure SQL format:
# Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;User ID=<user>;Password=<pwd>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
SQL_AUTH=
SQL_PRODUCT=
SQL_CART=
SQL_ORDER=
SQL_PAYMENT=
JWT_KEY=
JWT_ENCRYPTION_KEY=
# Shared secret for OrderAPI -> ProductAPI stock calls. Generate: openssl rand -base64 48
INTERNAL_API_KEY=
